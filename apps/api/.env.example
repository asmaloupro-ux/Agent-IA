# Copier en .env pour le dev local (sinon utiliser `npm run dev:railway`)
PORT=4000
# Postgres Railway (dev / previews) ou, en production, Supabase via le pooler en mode session :
# postgresql://postgres.<ref>:<mot-de-passe>@aws-0-eu-north-1.pooler.supabase.com:5432/postgres
# (SSL vérifié activé automatiquement pour les hôtes *.supabase.com / *.supabase.co)
DATABASE_URL=
CORS_ORIGINS=http://localhost:3000
